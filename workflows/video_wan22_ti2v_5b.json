{
  "unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {"unet_name": "Wan2.2-TI2V-5B-Q5_K_M.gguf"}
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan2.2_vae.safetensors"}
  },
  "keyframe": {
    "class_type": "LoadImage",
    "inputs": {"image": "keyframe.png"}
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "A slow push in towards the subject.", "clip": ["clip", 0]}
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "flicker, abrupt cuts, jitter, frozen image, distortion, blur, subtitles, watermark, low quality",
      "clip": ["clip", 0]
    }
  },
  "model": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["unet", 0], "shift": 8.0}
  },
  "latent": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["vae", 0], "width": 640, "height": 352, "length": 49, "batch_size": 1,
      "start_image": ["keyframe", 0]
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["model", 0], "seed": 0, "steps": 20, "cfg": 5.0, "sampler_name": "uni_pc",
      "scheduler": "simple", "positive": ["positive", 0], "negative": ["negative", 0],
      "latent_image": ["latent", 0], "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["sample", 0], "vae": ["vae", 0], "tile_size": 512, "overlap": 64,
      "temporal_size": 64, "temporal_overlap": 8
    }
  },
  "trim": {
    "class_type": "ImageFromBatch",
    "inputs": {"image": ["decode", 0], "batch_index": 0, "length": 48}
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["trim", 0], "fps": 24}
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["video", 0], "filename_prefix": "vidpipe/wan", "format": "mp4", "format.codec": "h264"}
  }
}
